[Unit]
Description=Verify owner-only overlay SSH grant
After=dlt-fixed-network.service
ConditionPathExists=/srv/dlt-state/fixed-network/owner-ssh-access.json
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/dlt-system-console/console_fixed_network_owner.py
TimeoutStartSec=40
Nice=10
MemoryMax=128M
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
