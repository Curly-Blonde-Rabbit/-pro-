 #ifdef CONFIG_THERMAL
+/* Legacy Darklighter DT supplies the common FCC table, not per-charger
+ * Xiaomi thermal tables. Preserve the existing non-CONFIG_THERMAL semantics
+ * instead of dereferencing an absent per-charger array. No limits invented.
+ */
+static int smblib_legacy_thermal_charging(struct smb_charger *chg)
+{
+	int level = chg->system_temp_level;
+	int rc, next;
+
+	if (!chg->thermal_mitigation || chg->thermal_levels <= 0 ||
+	    level < 0 || level >= chg->thermal_levels)
+		return -EINVAL;
+	if (level >= chg->thermal_levels - 1)
+		return vote(chg->chg_disable_votable, THERMAL_DAEMON_VOTER,
+			    true, 0);
+	if (!level) {
+		rc = vote(chg->usb_icl_votable, THERMAL_DAEMON_VOTER,
+			  false, 0);
+		next = vote(chg->fcc_votable, THERMAL_DAEMON_VOTER,
+			    false, 0);
+		return rc < 0 ? rc : next;
+	}
+	return vote(chg->fcc_votable, THERMAL_DAEMON_VOTER, true,
+		    chg->thermal_mitigation[level]);
+}
+
