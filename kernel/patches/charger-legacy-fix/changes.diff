+	    !chg->thermal_fcc_qc3_normal && !chg->thermal_fcc_pps_cp &&
+	    !chg->thermal_mitigation_icl)
+		return smblib_legacy_thermal_charging(chg);
 
 	if (chg->system_temp_level >= MAX_TEMP_LEVEL)
 		return 0;
